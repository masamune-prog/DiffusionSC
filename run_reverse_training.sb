#!/bin/bash
#SBATCH --job-name=deepsc_diff_reverse
#SBATCH --partition=UGGPU-TC1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=64G
#SBATCH --time=6:00:00
#SBATCH --signal=B:TERM@120
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Exit immediately if a command exits with a non-zero status
set -euo pipefail

# Create log directory if it does not exist
mkdir -p logs

# Print job diagnostics
echo "=================================================="
echo "Job ID:        ${SLURM_JOB_ID}"
echo "Node:          ${SLURM_NODELIST}"
echo "Start time:    $(date)"
echo "Submit dir:    ${SLURM_SUBMIT_DIR}"
echo "=================================================="

# Navigate to project root
cd "${SLURM_SUBMIT_DIR}"

# Ensure CUDA runtime diagnostics are recorded
nvidia-smi

# Execute reverse_sample trajectory training
# Can train from scratch or fine-tune from existing 1-step checkpoint:
PYTHONUNBUFFERED=1 uv run python -u diffusion_attempt_reverse.py \
    --no-t5 \
    --train-mode reverse \
    --train-ddim-steps 5 \
    --checkpoint-path channel_diffusion_reverse_ray.pt \
    --channel Rayleigh

echo "=================================================="
echo "Job finished at: $(date)"
echo "=================================================="
